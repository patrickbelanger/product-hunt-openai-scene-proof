DATABASE_URL=jdbc:postgresql://localhost:55432/sceneproof
DATABASE_USERNAME=sceneproof
DATABASE_PASSWORD=sceneproof-local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8085
OPENAI_API_KEY=
PAID_RUNS_ENABLED=true
PAID_RUNS_HOURLY_LIMIT=10
PAID_RUNS_DAILY_LIMIT=100
HTTP_READS_PER_MINUTE=600
HTTP_WRITES_PER_MINUTE=120
HTTP_MEDIA_PER_MINUTE=30
MEDIA_MINIMUM_FREE_BYTES=536870912
# PR2 pins gpt-6-astra server-side; project/media features work without a key.
# Optional smoke target; never a frontend OpenAI endpoint.
SCENEPROOF_API_URL=http://127.0.0.1:8085
# Media paths are resolved from the API process working directory.
MEDIA_ROOT=.local/media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
