{
  "openapi": "3.1.0",
  "info": {
    "title": "SceneProof API",
    "version": "0.1.0",
    "description": "Local development foundation. No authentication; do not expose publicly."
  },
  "paths": {
    "/api/v1/projects/{id}/rules": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "put": {
        "operationId": "updateProjectRules",
        "description": "Replace trimmed continuity rules, up to 8000 characters. Empty is allowed. No inference; prior analysis snapshots remain unchanged.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateRules" } } } },
        "responses": { "200": { "description": "Saved project", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } } }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/projects/{projectId}/references": {
      "parameters": [{ "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": {
        "operationId": "listReferences",
        "description": "All active visual references, creation time then UUID ascending, at most eight. Archived references remain retrievable by ID and through historical finding evidence.",
        "responses": { "200": { "description": "Active Bible", "content": { "application/json": { "schema": { "type": "array", "maxItems": 8, "items": { "$ref": "#/components/schemas/Reference" } } } } }, "default": { "$ref": "#/components/responses/Problem" } }
      },
      "post": {
        "operationId": "uploadReference",
        "description": "JPEG/PNG only, actual signature and decode, max 10 MiB, 16 MP, 8192 per side. Normalizes PNG to 1600 per side. Image identity is immutable. Max eight active and 100 lifetime references per project. No inference.",
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "additionalProperties": false, "required": ["file", "title", "guidance"], "properties": { "file": { "type": "string", "format": "binary" }, "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "guidance": { "type": "string", "maxLength": 2000 } } } } } },
        "responses": { "201": { "description": "Persisted normalized reference", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reference" } } } }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/projects/{projectId}/references/{referenceId}": {
      "parameters": [{ "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "referenceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": { "operationId": "getReference", "description": "Read current metadata, including archived references, within the owning project.", "responses": { "200": { "description": "Reference", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reference" } } } }, "default": { "$ref": "#/components/responses/Problem" } } },
      "put": {
        "operationId": "updateReference",
        "description": "Edit active reference title/guidance. Image cannot change; archived metadata cannot change. Historical analyses retain their submitted metadata. No inference.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReferenceMetadata" } } } },
        "responses": { "200": { "description": "Saved reference", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reference" } } } }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/projects/{projectId}/references/{referenceId}/archive": {
      "parameters": [{ "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "referenceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "post": { "operationId": "archiveReference", "description": "Idempotent irreversible archive from current Bible. Retains original image and historical usage. Replace an image by archiving then uploading a new reference. No inference.", "responses": { "200": { "description": "Archived reference", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reference" } } } }, "default": { "$ref": "#/components/responses/Problem" } } }
    },
    "/api/v1/projects/{projectId}/references/{referenceId}/content": {
      "parameters": [{ "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "referenceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": { "operationId": "getReferenceContent", "description": "Project-scoped immutable normalized PNG, hash verified, bounded reads; includes archived images. Missing/corrupt content fails safely.", "responses": { "200": { "description": "Normalized PNG", "content": { "image/png": { "schema": { "type": "string", "format": "binary" } } } }, "default": { "$ref": "#/components/responses/Problem" } } }
    },
    "/api/v1/projects/{projectId}/findings/{findingId}/references": {
      "parameters": [{ "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "findingId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": { "operationId": "listFindingReferences", "description": "Only cited references with original submitted title/guidance/dimensions/hash, in submission order. archivedAt reflects current archive state. Zero-reference findings return an empty array. No inference.", "responses": { "200": { "description": "Historical reference evidence", "content": { "application/json": { "schema": { "type": "array", "maxItems": 8, "items": { "$ref": "#/components/schemas/Reference" } } } } }, "default": { "$ref": "#/components/responses/Problem" } } }
    },
    "/api/v1/projects/{projectId}/findings/{findingId}/actions": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "findingId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "createFindingAction",
        "description": "An explicit INTENTIONAL_CHANGE authorizes one bounded targeted provider call. RESOLVE and DISMISS never call the provider. Scope must exactly match the original affected shots. Replaying the same requestId and payload returns the existing action without inference; changed payload conflicts. Failures retain the action and original finding. A new UUID explicitly authorizes a separate attempt.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFindingAction"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durable creator action and actual targeted result, if available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingAction"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "get": {
        "operationId": "listFindingActions",
        "description": "Read-only immutable history, oldest first, at most 100 actions. supersedesActionId links the preceding effective judgement; only a successful result becomes effective. Original finding fields/evidence remain intact.",
        "responses": {
          "200": {
            "description": "Durable creator action and actual targeted result, if available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FindingAction"
                  },
                  "minItems": 0,
                  "maxItems": 100
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/projects/{projectId}/findings/{findingId}/actions/{actionId}": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "findingId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "actionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getFindingAction",
        "responses": {
          "200": {
            "description": "Durable creator action and actual targeted result, if available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingAction"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
"/api/v1/projects/{projectId}/analyses": {"parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"createAnalysis","description":"Synchronous, at most one paid call. Reuse requestId after any network retry; an existing RUNNING or final run is returned without another model call. Failed attempts return Problem with analysisRunId. A new requestId explicitly authorizes a new attempt.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateAnalysis"}}}},"responses":{"200":{"description":"Current durable run; Location identifies its GET endpoint","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AnalysisRun"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},
"/api/v1/projects/{projectId}/analyses/{analysisId}": {"get":{"operationId":"getAnalysis","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"analysisId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Durable analysis state; stale interrupted runs become FAILED after five minutes","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AnalysisRun"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},
"/api/v1/projects/{projectId}/findings": {"get":{"operationId":"listFindings","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"analysisId","in":"query","schema":{"type":"string","format":"uuid"}},{"name":"page","in":"query","schema":{"type":"integer","minimum":0,"maximum":10000,"default":0}}],"responses":{"200":{"description":"Validated findings, newest analysis first, at most 20 per page","content":{"application/json":{"schema":{"type":"array","maxItems":20,"items":{"$ref":"#/components/schemas/Finding"}}}}},"default":{"$ref":"#/components/responses/Problem"}}}},
    "/api/v1/projects/{projectId}/shots": {
      "parameters": [{"name":"projectId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],
      "get": {"operationId":"listShots","responses":{"200":{"description":"Up to 100 import attempts in durable order","content":{"application/json":{"schema":{"type":"array","maxItems":100,"items":{"$ref":"#/components/schemas/Shot"}}}}},"default":{"$ref":"#/components/responses/Problem"}}},
      "post": {"operationId":"uploadShot","requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","format":"binary"}}}}}},"responses":{"201":{"description":"Imported shot with normalized frames","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Shot"}}}},"default":{"$ref":"#/components/responses/Problem"}}}
    },
    "/api/v1/projects/{projectId}/frames/{frameId}/content": {
      "get": {"operationId":"getFrameContent","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"frameId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Normalized frame; project membership checked","content":{"image/png":{"schema":{"type":"string","format":"binary"}}}},"default":{"$ref":"#/components/responses/Problem"}}}
    },
    "/api/v1/projects": {
      "get": {
        "operationId": "listProjects",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projects, newest first; pages contain at most 20 items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectPage"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "operationId": "createProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProject"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project persisted",
            "headers": {
              "Location": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/projects/{id}": {
      "get": {
        "operationId": "getProject",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateRules": { "type": "object", "additionalProperties": false, "required": ["rules"], "properties": { "rules": { "type": "string", "maxLength": 8000 } } },
      "ReferenceMetadata": { "type": "object", "additionalProperties": false, "required": ["title", "guidance"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "guidance": { "type": "string", "maxLength": 2000 } } },
      "Reference": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "projectId", "title", "guidance", "width", "height", "sha256", "createdAt", "archivedAt", "url"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }, "projectId": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "guidance": { "type": "string", "maxLength": 2000 },
          "width": { "type": "integer", "minimum": 1, "maximum": 1600 }, "height": { "type": "integer", "minimum": 1, "maximum": 1600 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "createdAt": { "type": "string", "format": "date-time" }, "archivedAt": { "type": ["string", "null"], "format": "date-time" },
          "url": { "type": "string" }
        }
      },
      "CreateFindingAction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "type",
          "explanation",
          "scope",
          "affectedShotIds"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "INTENTIONAL_CHANGE",
              "RESOLVE",
              "DISMISS"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "affectedShotIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "maxItems": 8
          }
        }
      },
      "TargetedResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "originalFindingId",
          "schemaVersion",
          "outcome",
          "summary",
          "explanation",
          "evaluatedScope",
          "affectedShotIds",
          "evidenceFrameIds",
          "inspectedShots",
          "remainingIssue",
          "suggestedCorrection"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "originalFindingId": {
            "type": "string",
            "format": "uuid"
          },
          "schemaVersion": {
            "type": "string",
            "enum": [
              "1"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "INTENT_ACCEPTED",
              "ISSUE_REMAINS",
              "INSUFFICIENT_EVIDENCE"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "evaluatedScope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "affectedShotIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "maxItems": 8
          },
          "evidenceFrameIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "maxItems": 24
          },
          "inspectedShots": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "shotId",
                "frameIds"
              ],
              "properties": {
                "shotId": {
                  "type": "string",
                  "format": "uuid"
                },
                "frameIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "minItems": 1,
                  "maxItems": 3
                }
              }
            },
            "minItems": 1,
            "maxItems": 8
          },
          "remainingIssue": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "suggestedCorrection": {
            "type": "string",
            "minLength": 0,
            "maxLength": 3000
          }
        }
      },
      "FindingAction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "projectId",
          "findingId",
          "originalAnalysisRunId",
          "requestId",
          "type",
          "explanation",
          "scope",
          "affectedShotIds",
          "createdAt",
          "supersedesActionId",
          "reanalysis",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "findingId": {
            "type": "string",
            "format": "uuid"
          },
          "originalAnalysisRunId": {
            "type": "string",
            "format": "uuid"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "INTENTIONAL_CHANGE",
              "RESOLVE",
              "DISMISS"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "affectedShotIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "maxItems": 8
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "supersedesActionId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "reanalysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisRun"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TargetedResult"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
"CreateAnalysis": {"type":"object","additionalProperties":false,"required":["requestId"],"properties":{"requestId":{"type":"string","format":"uuid"}}},
"AnalysisUsage": {"type":"object","additionalProperties":false,"required":["inputTokens","outputTokens","totalTokens","cachedInputTokens","reasoningTokens","cacheWriteTokens"],"properties":{"inputTokens":{"type":["integer","null"],"minimum":0},"outputTokens":{"type":["integer","null"],"minimum":0},"totalTokens":{"type":["integer","null"],"minimum":0},"cachedInputTokens":{"type":["integer","null"],"minimum":0},"reasoningTokens":{"type":["integer","null"],"minimum":0},"cacheWriteTokens":{"type":["integer","null"],"minimum":0}}},
"AnalysisRun": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "RUNNING",
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "OPENAI"
            ]
          },
          "model": {
            "type": "string",
            "enum": [
              "gpt-6-astra"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "failureCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "failureMessage": {
            "type": [
              "string",
              "null"
            ]
          },
          "shotCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "frameCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24
          },
          "projectSummary": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "warnings": {
            "type": "array",
            "maxItems": 22,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisUsage"
              },
              {
                "type": "null"
              }
            ]
          },
          "providerResponseId": {
            "type": [
              "string",
              "null"
            ]
          },
          "providerRequestId": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "SEQUENCE",
              "TARGETED"
            ]
          }
        },
        "required": [
          "id",
          "projectId",
          "requestId",
          "status",
          "provider",
          "model",
          "startedAt",
          "completedAt",
          "failureCode",
          "failureMessage",
          "shotCount",
          "frameCount",
          "projectSummary",
          "warnings",
          "usage",
          "providerResponseId",
          "providerRequestId",
          "kind"
        ]
      },
"Finding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "analysisRunId": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "type": "string",
            "enum": [
              "CHARACTER_IDENTITY",
              "CHARACTER_APPEARANCE",
              "HAIR",
              "WARDROBE",
              "PROP",
              "OBJECT_STATE",
              "ENVIRONMENT",
              "SPATIAL_CONTINUITY",
              "SCREEN_DIRECTION",
              "LIGHTING",
              "TIME_OF_DAY",
              "HAND_OBJECT_INTERACTION",
              "DEVICE_UI",
              "TEXT_CONTINUITY",
              "OTHER"
            ]
          },
