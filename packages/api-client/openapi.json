{
  "openapi": "3.1.0",
  "info": {
    "title": "SceneProof API",
    "version": "0.1.0",
    "description": "Local development foundation. No authentication; do not expose publicly."
  },
  "paths": {
"/api/v1/projects/{projectId}/analyses": {"parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"createAnalysis","description":"Synchronous, at most one paid call. Reuse requestId after any network retry; an existing RUNNING or final run is returned without another model call. Failed attempts return Problem with analysisRunId. A new requestId explicitly authorizes a new attempt.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateAnalysis"}}}},"responses":{"200":{"description":"Current durable run; Location identifies its GET endpoint","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AnalysisRun"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},
"/api/v1/projects/{projectId}/analyses/{analysisId}": {"get":{"operationId":"getAnalysis","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"analysisId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Durable analysis state; stale interrupted runs become FAILED after five minutes","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AnalysisRun"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},
"/api/v1/projects/{projectId}/findings": {"get":{"operationId":"listFindings","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"analysisId","in":"query","schema":{"type":"string","format":"uuid"}},{"name":"page","in":"query","schema":{"type":"integer","minimum":0,"maximum":10000,"default":0}}],"responses":{"200":{"description":"Validated findings, newest analysis first, at most 20 per page","content":{"application/json":{"schema":{"type":"array","maxItems":20,"items":{"$ref":"#/components/schemas/Finding"}}}}},"default":{"$ref":"#/components/responses/Problem"}}}},
    "/api/v1/projects/{projectId}/shots": {
      "parameters": [{"name":"projectId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],
      "get": {"operationId":"listShots","responses":{"200":{"description":"Up to 100 import attempts in durable order","content":{"application/json":{"schema":{"type":"array","maxItems":100,"items":{"$ref":"#/components/schemas/Shot"}}}}},"default":{"$ref":"#/components/responses/Problem"}}},
      "post": {"operationId":"uploadShot","requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","format":"binary"}}}}}},"responses":{"201":{"description":"Imported shot with normalized frames","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Shot"}}}},"default":{"$ref":"#/components/responses/Problem"}}}
    },
    "/api/v1/projects/{projectId}/frames/{frameId}/content": {
      "get": {"operationId":"getFrameContent","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"frameId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Normalized frame; project membership checked","content":{"image/png":{"schema":{"type":"string","format":"binary"}}}},"default":{"$ref":"#/components/responses/Problem"}}}
    },
    "/api/v1/projects": {
      "get": {
        "operationId": "listProjects",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projects, newest first; pages contain at most 20 items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectPage"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "operationId": "createProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProject"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project persisted",
            "headers": {
              "Location": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/projects/{id}": {
      "get": {
        "operationId": "getProject",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
"CreateAnalysis": {"type":"object","additionalProperties":false,"required":["requestId"],"properties":{"requestId":{"type":"string","format":"uuid"}}},
"AnalysisUsage": {"type":"object","additionalProperties":false,"required":["inputTokens","outputTokens","totalTokens","cachedInputTokens","reasoningTokens","cacheWriteTokens"],"properties":{"inputTokens":{"type":["integer","null"],"minimum":0},"outputTokens":{"type":["integer","null"],"minimum":0},"totalTokens":{"type":["integer","null"],"minimum":0},"cachedInputTokens":{"type":["integer","null"],"minimum":0},"reasoningTokens":{"type":["integer","null"],"minimum":0},"cacheWriteTokens":{"type":["integer","null"],"minimum":0}}},
"AnalysisRun": {"type":"object","additionalProperties":false,"properties":{"id":{"type":"string","format":"uuid"},"projectId":{"type":"string","format":"uuid"},"requestId":{"type":"string","format":"uuid"},"status":{"type":"string","enum":["RUNNING","SUCCEEDED","FAILED"]},"provider":{"type":"string","enum":["OPENAI"]},"model":{"type":"string","enum":["gpt-6-astra"]},"startedAt":{"type":"string","format":"date-time"},"completedAt":{"type":["string","null"],"format":"date-time"},"failureCode":{"type":["string","null"]},"failureMessage":{"type":["string","null"]},"shotCount":{"type":"integer","minimum":0,"maximum":8},"frameCount":{"type":"integer","minimum":0,"maximum":24},"projectSummary":{"type":["string","null"],"maxLength":2000},"warnings":{"type":"array","maxItems":22,"items":{"type":"string","maxLength":500}},"usage":{"anyOf":[{"$ref":"#/components/schemas/AnalysisUsage"},{"type":"null"}]},"providerResponseId":{"type":["string","null"]},"providerRequestId":{"type":["string","null"]}},"required":["id","projectId","requestId","status","provider","model","startedAt","completedAt","failureCode","failureMessage","shotCount","frameCount","projectSummary","warnings","usage","providerResponseId","providerRequestId"]},
"Finding": {"type":"object","additionalProperties":false,"properties":{"id":{"type":"string","format":"uuid"},"analysisRunId":{"type":"string","format":"uuid"},"category":{"type":"string","enum":["CHARACTER_IDENTITY","CHARACTER_APPEARANCE","HAIR","WARDROBE","PROP","OBJECT_STATE","ENVIRONMENT","SPATIAL_CONTINUITY","SCREEN_DIRECTION","LIGHTING","TIME_OF_DAY","HAND_OBJECT_INTERACTION","DEVICE_UI","TEXT_CONTINUITY","OTHER"]},"severity":{"type":"string","enum":["LOW","MEDIUM","HIGH"]},"confidence":{"type":"number","minimum":0,"maximum":1},"title":{"type":"string","minLength":1,"maxLength":160},"summary":{"type":"string","minLength":1,"maxLength":1000},"expectedState":{"type":"string","minLength":1,"maxLength":2000},"observedState":{"type":"string","minLength":1,"maxLength":2000},"explanation":{"type":"string","minLength":1,"maxLength":3000},"affectedShotIds":{"type":"array","items":{"type":"string","format":"uuid"},"minItems":1,"maxItems":8},"relevantFrameIds":{"type":"array","items":{"type":"string","format":"uuid"},"minItems":1,"maxItems":24},"relevantReferenceIds":{"type":"array","items":{"type":"string","format":"uuid"},"minItems":0,"maxItems":0},"suggestedCorrectionPrompt":{"type":"string","minLength":1,"maxLength":3000},"status":{"type":"string","enum":["OPEN"]}},"required":["id","analysisRunId","category","severity","confidence","title","summary","expectedState","observedState","explanation","affectedShotIds","relevantFrameIds","relevantReferenceIds","suggestedCorrectionPrompt","status"]},
      "Frame": {
        "type":"object","additionalProperties":false,"required":["id","position","timestampMs","width","height","url"],
        "properties":{"id":{"type":"string","format":"uuid"},"position":{"type":"integer","minimum":0,"maximum":31},"timestampMs":{"type":["integer","null"],"minimum":0,"maximum":120000},"width":{"type":"integer","minimum":1,"maximum":1600},"height":{"type":"integer","minimum":1,"maximum":1600},"url":{"type":"string","pattern":"^/api/v1/projects/[0-9a-f-]{36}/frames/[0-9a-f-]{36}/content$"}}
      },
      "Shot": {
        "type":"object","additionalProperties":false,"required":["id","position","name","kind","status","failureCode","durationMs","frames"],
        "properties":{"id":{"type":"string","format":"uuid"},"position":{"type":"integer","minimum":0,"maximum":99},"name":{"type":"string","minLength":1,"maxLength":160},"kind":{"type":"string","enum":["IMAGE","VIDEO","UNKNOWN"]},"status":{"type":"string","enum":["READY","FAILED"]},"failureCode":{"type":["string","null"]},"durationMs":{"type":["integer","null"],"minimum":1,"maximum":120000},"frames":{"type":"array","maxItems":32,"items":{"$ref":"#/components/schemas/Frame"}}}
      },
      "CreateProject": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "default": ""
          },
          "rules": {
            "type": "string",
            "maxLength": 8000,
            "default": ""
          }
        }
      },
      "Project": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "rules",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "rules": {
            "type": "string",
            "maxLength": 8000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "hasNext"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "default": "about:blank",
            "description": "Omission means about:blank per RFC 9457."
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "analysisRunId": {
            "type": "string",
            "format": "uuid",
            "description": "Durable run identifier when an admitted analysis fails."
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "RFC 9457 problem response",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
