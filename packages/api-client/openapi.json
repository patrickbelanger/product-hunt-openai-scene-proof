{
  "openapi": "3.1.0",
  "info": {
    "title": "SceneProof API",
    "version": "0.1.0",
    "description": "Local development foundation. No authentication; do not expose publicly."
  },
  "paths": {
    "/api/v1/projects/{projectId}/shots": {
      "parameters": [{"name":"projectId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],
      "get": {"operationId":"listShots","responses":{"200":{"description":"Up to 100 import attempts in durable order","content":{"application/json":{"schema":{"type":"array","maxItems":100,"items":{"$ref":"#/components/schemas/Shot"}}}}},"default":{"$ref":"#/components/responses/Problem"}}},
      "post": {"operationId":"uploadShot","requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","format":"binary"}}}}}},"responses":{"201":{"description":"Imported shot with normalized frames","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Shot"}}}},"default":{"$ref":"#/components/responses/Problem"}}}
    },
    "/api/v1/projects/{projectId}/frames/{frameId}/content": {
      "get": {"operationId":"getFrameContent","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"frameId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Normalized frame; project membership checked","content":{"image/png":{"schema":{"type":"string","format":"binary"}}}},"default":{"$ref":"#/components/responses/Problem"}}}
    },
    "/api/v1/projects": {
      "get": {
        "operationId": "listProjects",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projects, newest first; pages contain at most 20 items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectPage"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "operationId": "createProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProject"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project persisted",
            "headers": {
              "Location": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/projects/{id}": {
      "get": {
        "operationId": "getProject",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Frame": {
        "type":"object","additionalProperties":false,"required":["id","position","timestampMs","width","height","url"],
        "properties":{"id":{"type":"string","format":"uuid"},"position":{"type":"integer","minimum":0,"maximum":31},"timestampMs":{"type":["integer","null"],"minimum":0,"maximum":120000},"width":{"type":"integer","minimum":1,"maximum":1600},"height":{"type":"integer","minimum":1,"maximum":1600},"url":{"type":"string","pattern":"^/api/v1/projects/[0-9a-f-]{36}/frames/[0-9a-f-]{36}/content$"}}
      },
      "Shot": {
        "type":"object","additionalProperties":false,"required":["id","position","name","kind","status","failureCode","durationMs","frames"],
        "properties":{"id":{"type":"string","format":"uuid"},"position":{"type":"integer","minimum":0,"maximum":99},"name":{"type":"string","minLength":1,"maxLength":160},"kind":{"type":"string","enum":["IMAGE","VIDEO","UNKNOWN"]},"status":{"type":"string","enum":["READY","FAILED"]},"failureCode":{"type":["string","null"]},"durationMs":{"type":["integer","null"],"minimum":1,"maximum":120000},"frames":{"type":"array","maxItems":32,"items":{"$ref":"#/components/schemas/Frame"}}}
      },
      "CreateProject": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "default": ""
          },
          "rules": {
            "type": "string",
            "maxLength": 8000,
            "default": ""
          }
        }
      },
      "Project": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "rules",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "rules": {
            "type": "string",
            "maxLength": 8000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "hasNext"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "default": "about:blank",
            "description": "Omission means about:blank per RFC 9457."
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "RFC 9457 problem response",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
